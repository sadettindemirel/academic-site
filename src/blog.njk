---
layout: base.njk
permalink: /blog/
title: Blog
description: Dr. Sadettin Demirel'in yeni medya, veri gazeteciliği ve programlamalı sosyal bilimler üzerine blog yazıları.
nav: blog
---
        <section class="blog-listing section">
            <div class="container container-wide">
                <h1 class="blog-eyebrow">Blog</h1>

                {% set featured = collections.blog.slice(0, 5) %}
                <div class="blog-banner" role="region" aria-roledescription="carousel" aria-label="Son yazılar">
                    <div class="banner-track">
                        {% for post in featured %}
                        <a href="{{ post.url }}" class="banner-slide" aria-label="{{ loop.index }} / {{ featured.length }}">
                            <div class="banner-image">
                                <img src="{{ post.data.thumbnail }}" alt="" {% if not loop.first %}loading="lazy"{% endif %}>
                            </div>
                            <div class="banner-caption">
                                <span class="banner-date">{{ post.data.date | trDate }}</span>
                                <h2 class="banner-title">{{ post.data.title }}</h2>
                            </div>
                        </a>
                        {% endfor %}
                    </div>
                    <button type="button" class="banner-arrow banner-prev" aria-label="Önceki yazı"><i class="fas fa-chevron-left"></i></button>
                    <button type="button" class="banner-arrow banner-next" aria-label="Sonraki yazı"><i class="fas fa-chevron-right"></i></button>
                    <div class="banner-dots">
                        {% for post in featured %}
                        <button type="button" class="banner-dot" aria-label="{{ loop.index }}. yazı"></button>
                        {% endfor %}
                    </div>
                </div>

                <div class="blog-grid">
                    {% for post in collections.blog.slice(5) %}
                    <a href="{{ post.url }}" class="blog-card">
                        {% if post.data.thumbnail %}
                        <div class="blog-card-image">
                            <img src="{{ post.data.thumbnail }}" alt="" loading="lazy">
                        </div>
                        {% endif %}
                        <div class="blog-card-body">
                            <span class="blog-card-date">{{ post.data.date | trDate }}</span>
                            <h3 class="blog-card-title">{{ post.data.title }}</h3>
                            <p class="blog-card-excerpt">{{ post.data.excerpt }}</p>
                            <span class="blog-card-read" data-tr="Devamını Oku" data-en="Read More">Devamını Oku <i class="fas fa-arrow-right"></i></span>
                        </div>
                    </a>
                    {% endfor %}
                </div>
            </div>
        </section>
