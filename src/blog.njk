---
layout: base.njk
permalink: /blog/
title: Blog
description: Dr. Sadettin Demirel'in yeni medya, veri gazeteciliği ve programlamalı sosyal bilimler üzerine blog yazıları.
nav: blog
---
        <section class="blog-listing section">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">Blog</h2>
                    <div class="divider"></div>
                </div>
                <div class="blog-grid">
                    {% for post in collections.blog %}
                    <a href="{{ post.url }}" class="blog-card">
                        {% if post.data.thumbnail %}
                        <div class="blog-card-image">
                            <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy">
                        </div>
                        {% endif %}
                        <div class="blog-card-body">
                            <span class="blog-card-date">{{ post.data.date | trDate }}</span>
                            <h3 class="blog-card-title">{{ post.data.title }}</h3>
                            <p class="blog-card-excerpt">{{ post.data.excerpt }}</p>
                            <span class="blog-card-read" data-tr="Devamını Oku" data-en="Read More">Devamını Oku <i class="fas fa-arrow-right"></i></span>
                        </div>
                    </a>
                    {% endfor %}
                </div>

                <!-- Yazılarım Section (moved from main page) -->
                <hr class="section-divider">
                <div class="section-header" style="margin-top: var(--spacing-lg);">
                    <h2 class="section-title" data-tr="Yazılarım" data-en="My Writings">Yazılarım</h2>
                    <div class="divider"></div>
                </div>
                <div class="writings-content">
                    {% for writing in site.writings %}
                    <div class="writing-promo">
                        <div class="writing-icon">
                            <i class="{{ writing.icon }}"></i>
                        </div>
                        <h3>{{ writing.name }}</h3>
                        <p data-tr="{{ writing.description }}" data-en="{{ writing.description_en }}">{{ writing.description }}</p>
                        <a href="{{ writing.url }}" target="_blank" rel="noopener noreferrer"
                            class="btn btn-outline mt-auto">
                            <span data-tr="{{ writing.button_text }}" data-en="{{ writing.button_text_en }}">{{ writing.button_text }}</span> <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>
