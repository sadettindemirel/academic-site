{% from "macros.njk" import linkIcon %}
{% set onHome = page.url == "/" %}
{% set navBase = "" if onHome else "/" %}
{% set fullTitle = (title ~ " — Dr. " ~ site.name) if title else (site.title ~ " " ~ site.name ~ " | Akademik Profil") %}
{% set metaDescription = description or excerpt or site.bio_summary %}
{% set canonicalUrl = siteUrl ~ page.url %}
{% if thumbnail %}
{% set ogImage = thumbnail if thumbnail.startsWith("http") else siteUrl ~ thumbnail %}
{% else %}
{% set ogImage = siteUrl ~ "/profile.jpeg" %}
{% endif %}
<!DOCTYPE html>
<html lang="tr" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Apply saved (or system) theme before first paint to avoid a light flash in dark mode -->
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('theme');
                if (!theme) theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', theme.indexOf('dark') > -1 ? 'dark' : 'light');
            } catch (e) { }
        })();
    </script>

    <title>{{ fullTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <meta name="author" content="{{ site.name }}">
    <link rel="canonical" href="{{ canonicalUrl }}">
    {% if noindex %}<meta name="robots" content="noindex">{% endif %}

    <!-- Open Graph / social sharing previews -->
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:site_name" content="Dr. {{ site.name }}">
    <meta property="og:locale" content="tr_TR">
    <meta property="og:title" content="{{ fullTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ ogImage }}">
    <meta name="twitter:card" content="{{ 'summary_large_image' if thumbnail else 'summary' }}">
    <meta name="twitter:site" content="@demirelsadettin">
    {% if ogType == "article" and date %}
    <meta property="article:published_time" content="{{ date | dateIso }}">
    {% endif %}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/profile.jpeg">

    <!-- Structured data for search engines -->
    {% if onHome %}
    <script type="application/ld+json">{{ site | personJsonLd(siteUrl) | safe }}</script>
    {% elif ogType == "article" %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": {{ title | dump | safe }},
        "description": {{ metaDescription | dump | safe }},
        "datePublished": {{ date | dateIso | dump | safe }},
        "image": {{ ogImage | dump | safe }},
        "url": {{ canonicalUrl | dump | safe }},
        "author": { "@type": "Person", "name": {{ (author or site.name) | dump | safe }}, "url": {{ siteUrl | dump | safe }} }
    }
    </script>
    {% endif %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap"
        rel="stylesheet">

    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Header & Navigation -->
    <header class="header" id="header">
        <div class="container nav-container">
            <a href="{{ '#home' if onHome else '/' }}" class="logo">SD.</a>
            <nav class="navbar">
                <ul class="nav-list">
                    <li><a href="{{ navBase }}#home" class="nav-link{% if onHome %} active{% endif %}" data-tr="Hakkımda" data-en="About">Hakkımda</a></li>
                    <li><a href="{{ navBase }}#cv" class="nav-link" data-tr="Özgeçmiş" data-en="CV">Özgeçmiş</a></li>
                    <li><a href="/publications/" class="nav-link{% if nav == 'publications' %} active{% endif %}" data-tr="Yayınlarım" data-en="Publications">Yayınlarım</a></li>
                    <li><a href="/blog/" class="nav-link{% if nav == 'blog' %} active{% endif %}">Blog</a></li>
                    <li><a href="{{ navBase }}#iletisim" class="nav-link" data-tr="İletişim" data-en="Contact">İletişim</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <button class="toggle-btn" id="langToggle" title="Switch language" aria-label="Switch language">
                    <span class="lang-label">EN</span>
                </button>
                <button class="toggle-btn" id="themeToggle" title="Tema değiştir" aria-label="Toggle dark mode">
                    <i class="fas fa-moon"></i>
                </button>
                <div class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </div>
            </div>
        </div>
    </header>

    <main>
        {{ content | safe }}
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container footer-container">
            <div class="footer-info">
                <p>&copy; <span id="currentYear"></span> Dr. {{ site.name }}. <span data-tr="Tüm hakları saklıdır." data-en="All rights reserved.">Tüm hakları saklıdır.</span></p>
            </div>
            <div class="footer-social">
                {% for link in site.social_links %}
                {% if link.platform != "email" %}
                <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" title="{{ link.label }}" aria-label="{{ link.label }}">{{ linkIcon(link) }}</a>
                {% endif %}
                {% endfor %}
            </div>
        </div>
    </footer>

    <!-- Custom Script -->
    <script src="/script.js"></script>

</body>

</html>
