---
layout: base.njk
---
        <article class="blog-post section">
            <div class="container">
                <div class="post-header">
                    {% if thumbnail %}
                    <img src="{{ thumbnail }}" alt="{{ title }}" class="post-hero-image">
                    {% endif %}
                    <h1 class="post-title">{{ title }}</h1>
                    <div class="post-meta">
                        <span><i class="fas fa-calendar-alt"></i> {{ date | trDate }}</span>
                        <span><i class="fas fa-user"></i> {{ author }}</span>
                        {% if tags_display %}
                        <span><i class="fas fa-tags"></i> {{ tags_display }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="post-content">
                    {{ content | safe }}
                </div>
                {% if original_url %}
                <p class="post-origin">
                    <i class="fas fa-link"></i>
                    <span data-tr="Bu yazı ilk olarak {{ original_source }} üzerinde yayımlanmıştır:" data-en="This article was originally published on {{ original_source }}:">Bu yazı ilk olarak {{ original_source }} üzerinde yayımlanmıştır:</span>
                    <a href="{{ original_url }}" target="_blank" rel="noopener noreferrer">{{ original_url | replace("https://", "") | truncate(60) }}</a>
                </p>
                {% endif %}
                <div class="post-footer">
                    <a href="/blog/" class="btn btn-outline" data-tr="Tüm Yazılar" data-en="All Posts"><i class="fas fa-arrow-left"></i> Tüm Yazılar</a>
                </div>
            </div>
        </article>
