---
layout: base.njk
---
{% from "macros.njk" import linkIcon %}
        <!-- Hero Section -->
        <section id="home" class="hero section">
            <div class="container hero-container">
                <div class="hero-content">
                    <div class="hero-text">
                        <span class="greeting" data-tr="{{ site.greeting }}" data-en="{{ site.greeting_en }}">{{ site.greeting }}</span>
                        <h1 class="name">{{ site.name }}</h1>
                        <h2 class="title" data-tr="{{ site.title }}" data-en="{{ site.title_en }}">{{ site.title }}</h2>
                        <p class="bio-summary" data-tr="{{ site.bio_summary }}" data-en="{{ site.bio_summary_en }}">{{ site.bio_summary }}</p>

                        <div class="hero-actions">
                            {% if site.cv_url %}
                            <a href="{{ site.cv_url }}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                                <i class="fas fa-file-lines"></i> <span data-tr="Detaylı Özgeçmiş" data-en="Full CV">Detaylı Özgeçmiş</span>
                            </a>
                            {% endif %}
                            <div class="social-links">
                                {% for link in site.social_links %}
                                {% if link.group != "academic" and link.hero %}
                                <a href="{{ link.url }}" class="social-icon" target="_blank" rel="noopener noreferrer"
                                    title="{{ link.label }}" aria-label="{{ link.label }}">{{ linkIcon(link) }}</a>
                                {% endif %}
                                {% endfor %}
                            </div>
                        </div>

                        {% include "metrics.njk" %}

                        <div class="profile-links">
                            <span class="profile-links-label" data-tr="Akademik profiller" data-en="Academic profiles">Akademik profiller</span>
                            {% for link in site.social_links %}
                            {% if link.group == "academic" and link.hero %}
                            <a href="{{ link.url }}" class="profile-pill" target="_blank" rel="noopener noreferrer">
                                {{ linkIcon(link) }} {{ link.label }}
                            </a>
                            {% endif %}
                            {% endfor %}
                        </div>
                    </div>

                    <div class="hero-image-container">
                        <div class="image-wrapper">
                            <img src="/profile.jpeg" alt="Dr. {{ site.name }}" class="profile-img" id="profileImage"
                                onerror="this.src='https://ui-avatars.com/api/?name=Sadettin+Demirel&size=400&background=1c1917&color=f7f4ed'">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Full Bio Section -->
        <section id="about" class="about section bg-light">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title" data-tr="Hakkımda" data-en="About Me">Hakkımda</h2>
                    <div class="divider"></div>
                </div>
                <div class="about-content">
                    {% for i in range(0, site.about_paragraphs | length) %}
                    <p data-tr="{{ site.about_paragraphs[i] }}" data-en="{{ site.about_paragraphs_en[i] }}">{{ site.about_paragraphs[i] }}</p>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Featured Publications & Citations -->
        <section id="yayinlar" class="home-publications section">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title" data-tr="Öne Çıkan Yayınlar" data-en="Selected Publications">Öne Çıkan Yayınlar</h2>
                    <div class="divider"></div>
                </div>
                <div class="home-pubs">
                    <div class="publications-list">
                        {% for pub in publications.categories | featuredPubs %}
                        {% include "pub-card.njk" %}
                        {% endfor %}
                    </div>
                    <aside class="home-pubs-chart">
                        {% include "citation-chart.njk" %}
                    </aside>
                </div>
                <div class="home-pubs-more">
                    <a href="/publications/" class="btn btn-outline">
                        <span data-tr="Tüm Yayınlar" data-en="All Publications">Tüm Yayınlar</span> <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- CV Section -->
        <section id="cv" class="cv section bg-light">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title" data-tr="Özgeçmiş" data-en="Curriculum Vitae">Özgeçmiş</h2>
                    <div class="divider"></div>
                </div>
                <div class="cv-content">
                    <!-- Education Card -->
                    <div class="cv-card">
                        <div class="cv-icon">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <div class="cv-details">
                            <h3 data-tr="Eğitim" data-en="Education">Eğitim</h3>
                            <ul class="timeline">
                                {% for edu in site.education %}
                                <li>
                                    <span class="date">{{ edu.year }}</span>
                                    <h4 data-tr="{{ edu.degree }}" data-en="{{ edu.degree_en }}">{{ edu.degree }}</h4>
                                    <p data-tr="{{ edu.institution }}" data-en="{{ edu.institution_en }}">{{ edu.institution }}</p>
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>

                    <!-- Career Card -->
                    <div class="cv-card">
                        <div class="cv-icon">
                            <i class="fas fa-briefcase"></i>
                        </div>
                        <div class="cv-details">
                            <h3 data-tr="Kariyer" data-en="Career">Kariyer</h3>
                            <ul class="timeline">
                                {% for job in site.career %}
                                <li>
                                    <span class="date" {% if job.year_en %}data-tr="{{ job.year }}" data-en="{{ job.year_en }}"{% endif %}>{{ job.year }}</span>
                                    <h4 data-tr="{{ job.position }}" data-en="{{ job.position_en }}">{{ job.position }}</h4>
                                    <p data-tr="{{ job.institution }}" data-en="{{ job.institution_en }}">{{ job.institution }}</p>
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>

                    {% if site.cv_url %}
                    <div class="download-cv">
                        <a href="{{ site.cv_url }}" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
                            <i class="fas fa-file-lines"></i> <span data-tr="Detaylı Özgeçmiş (YÖK)" data-en="Full CV (YÖK)">Detaylı Özgeçmiş (YÖK)</span>
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </section>


        <!-- Contact Section -->
        <section id="iletisim" class="contact section">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title" data-tr="İletişim" data-en="Contact">İletişim</h2>
                    <div class="divider"></div>
                </div>
                <div class="contact-content">
                    <p style="text-align: center; margin-bottom: 2rem;"
                       data-tr="Benimle iletişime geçmek için aşağıdaki formu doldurabilirsiniz."
                       data-en="You can fill out the form below to get in touch with me.">
                        Benimle iletişime geçmek için aşağıdaki formu doldurabilirsiniz.
                    </p>
                    <!-- Netlify Forms: submissions appear in Netlify > Forms; email notifications are set there -->
                    <form name="iletisim" method="POST" action="/tesekkurler/" data-netlify="true"
                        netlify-honeypot="bot-field" class="contact-form" id="contactForm">
                        <input type="hidden" name="form-name" value="iletisim">
                        <!-- Honeypot -->
                        <p style="display:none"><label>Boş bırakın: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
                        <div class="form-group">
                            <label for="name" data-tr="Adınız Soyadınız" data-en="Full Name">Adınız Soyadınız</label>
                            <input type="text" id="name" name="name" class="form-control" required
                                data-tr-placeholder="Adınız Soyadınız" data-en-placeholder="Your full name"
                                placeholder="Adınız Soyadınız">
                        </div>
                        <div class="form-group">
                            <label for="email" data-tr="E-posta Adresiniz" data-en="Email Address">E-posta Adresiniz</label>
                            <input type="email" id="email" name="email" class="form-control" required
                                data-tr-placeholder="E-posta adresiniz" data-en-placeholder="Your email address"
                                placeholder="E-posta adresiniz">
                        </div>
                        <div class="form-group">
                            <label for="message" data-tr="Mesajınız" data-en="Your Message">Mesajınız</label>
                            <textarea id="message" name="message" class="form-control" required
                                data-tr-placeholder="Mesajınızı buraya yazın..." data-en-placeholder="Write your message here..."
                                placeholder="Mesajınızı buraya yazın..."></textarea>
                        </div>
                        <!-- Matematik CAPTCHA -->
                        <div class="form-group">
                            <label for="captcha"><i class="fas fa-shield-alt"></i> <span data-tr="Güvenlik Sorusu:" data-en="Security Question:">Güvenlik Sorusu:</span> <strong id="captchaQuestion"></strong></label>
                            <input type="number" id="captcha" class="form-control" required
                                data-tr-placeholder="Cevabınızı yazın" data-en-placeholder="Enter your answer"
                                placeholder="Cevabınızı yazın">
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
                            <i class="fas fa-paper-plane"></i> <span data-tr="Mesaj Gönder" data-en="Send Message">Mesaj Gönder</span>
                        </button>
                    </form>
                </div>
            </div>
        </section>
